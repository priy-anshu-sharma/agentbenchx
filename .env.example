# AgentBenchX Environment Variables
# Copy this file to .env and fill in the actual values

# Backend Configuration
DEBUG=False
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
DATABASE_URL=postgresql://agentbenchx:agentbenchx_password@localhost:5432/agentbenchx

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Future AI Provider API Keys (examples - add as needed)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# Redis Configuration (future)
# REDIS_URL=redis://localhost:6379/0

# Celery Configuration (future)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# External Service URLs (future)
# FRONTEND_URL=http://localhost:3000